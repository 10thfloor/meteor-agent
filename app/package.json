{
  "name": "app",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "types": "rm -rf packages/agent/types && tsc -p tsconfig.types.json",
    "types:check": "npm run types && git diff --exit-code -- packages/agent/types packages/agent/index.d.ts",
    "test": "meteor test --once --driver-package meteortesting:mocha",
    "test-app": "TEST_WATCH=1 meteor test --full-app --driver-package meteortesting:mocha",
    "visualize": "meteor --production --extra-packages bundle-visualizer"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.5",
    "@earendil-works/pi-ai": "^0.84.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@swc/helpers": "^0.5.17",
    "meteor-node-stubs": "^1.2.12",
    "typebox": "^1.3.7"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    },
    "testModule": "tests/main.js",
    "modern": true
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/meteor": "^2.9.11",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
