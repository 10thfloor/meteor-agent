{
  // Type-check-ONLY config (never emits): Meteor transpiles by stripping types,
  // so nothing here compiles the app — `tsc --noEmit` exists purely to catch the
  // one class of bug Meteor's build silently ships, a mistyped field name in a
  // `$set`/`$inc`/selector/insert (e.g. `budgetSpent.toolCall`) that quietly
  // disables a budget or misses a row. The `common/db.ts` typed-collection facade
  // now catches that WHOLE class: selectors and modifiers are field-name-checked
  // (a top-level typo is a compile error) while dotted paths stay legal via
  // template-literal index signatures. The residual `as any` is down to ~7 genuine
  // @types-gap boundaries (Meteor.settings, DDP/DDPCommon internals, dynamic MCP
  // ESM imports, a pi-ai model field, native driver methods) — documented, not
  // laziness. `strict` is on; the burndown is recorded in .superpowers/sdd/progress.md.
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["meteor", "mocha", "chai", "node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "paths": {
      // Off the Meteor build there is no `meteor/10thfloor:agent` module, so
      // `tsc` needs telling what that id resolves to. Every type-checked
      // importer of it is a SERVER-ONLY channel package (`api.use('10thfloor:agent',
      // 'server')`), and the server entry is exactly the module they resolve at
      // runtime — so that is what the id points at. `paths` cannot split by
      // architecture: a client-side TypeScript importer of the id would need its
      // own id/entry (none exists today — the demo app's client is plain JS,
      // outside this config's `include`).
      "meteor/10thfloor:agent": ["./packages/agent/server/index.ts"],
      "meteor/10thfloor:agent-channel-slack": ["./packages/agent-channel-slack/server/index.ts"],
      "meteor/10thfloor:agent-channel-telegram": ["./packages/agent-channel-telegram/server/index.ts"],
      "meteor/10thfloor:agent-channel-whatsapp": ["./packages/agent-channel-whatsapp/server/index.ts"],
      "meteor/10thfloor:agent-channel-sms": ["./packages/agent-channel-sms/server/index.ts"],
      "meteor/10thfloor:agent-channel-email": ["./packages/agent-channel-email/server/index.ts"]
    }
  },
  "include": [
    "packages/agent/**/*.ts",
    "packages/agent-channel-slack/**/*.ts",
    "packages/agent-channel-telegram/**/*.ts",
    "packages/agent-channel-whatsapp/**/*.ts",
    "packages/agent-channel-sms/**/*.ts",
    "packages/agent-channel-email/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".meteor"
  ]
}
