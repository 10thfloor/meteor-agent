{
  // Type-check-ONLY config (never emits): Meteor transpiles by stripping types,
  // so nothing here compiles the app — `tsc --noEmit` exists purely to catch the
  // one class of bug Meteor's build silently ships: a mistyped field name in a
  // `$set`/`$inc`/selector/insert that quietly disables a budget or misses a row.
  // The typed-collection facade checks top-level selector and modifier fields;
  // dotted paths stay legal through template-literal index signatures.
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["meteor", "mocha", "chai", "node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "paths": {
      // Outside Meteor's build, TypeScript needs explicit paths for package ids.
      // Channel packages are server-only and therefore resolve the core id to
      // its server entry. Meteor still selects architecture-specific entry
      // modules for application imports at runtime.
      "meteor/10thfloor:agent": ["./packages/agent/server/index.ts"],
      "meteor/10thfloor:agent-channel-slack": ["./packages/agent-channel-slack/server/index.ts"],
      "meteor/10thfloor:agent-channel-telegram": ["./packages/agent-channel-telegram/server/index.ts"],
      "meteor/10thfloor:agent-channel-whatsapp": ["./packages/agent-channel-whatsapp/server/index.ts"],
      "meteor/10thfloor:agent-channel-sms": ["./packages/agent-channel-sms/server/index.ts"],
      "meteor/10thfloor:agent-channel-email": ["./packages/agent-channel-email/server/index.ts"]
    }
  },
  "include": [
    "packages/agent/**/*.ts",
    "packages/agent-channel-slack/**/*.ts",
    "packages/agent-channel-telegram/**/*.ts",
    "packages/agent-channel-whatsapp/**/*.ts",
    "packages/agent-channel-sms/**/*.ts",
    "packages/agent-channel-email/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".meteor"
  ]
}
