{
  // Type-check-ONLY config (never emits): Meteor transpiles by stripping types,
  // so nothing here compiles the app — `tsc --noEmit` exists purely to catch the
  // one class of bug Meteor's build silently ships, a mistyped field name in a
  // `$set`/`$inc`/selector/insert (e.g. `budgetSpent.toolCall`) that quietly
  // disables a budget or misses a row. The `common/db.ts` typed-collection facade
  // now catches that WHOLE class: selectors and modifiers are field-name-checked
  // (a top-level typo is a compile error) while dotted paths stay legal via
  // template-literal index signatures. The residual `as any` is down to ~7 genuine
  // @types-gap boundaries (Meteor.settings, DDP/DDPCommon internals, dynamic MCP
  // ESM imports, a pi-ai model field, native driver methods) — documented, not
  // laziness. `strict` is on; the burndown is recorded in .superpowers/sdd/progress.md.
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["meteor", "mocha", "chai", "node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "paths": {
      // The package imports its own public surface through the Meteor namespace
      // (`meteor/10thfloor:agent`); off the Meteor build there is no such module,
      // so point it at the client entry that re-exports that surface. The client
      // entry also re-exports the (pure, isomorphic) channel lens contract, so
      // channel packages type-check against the same module id they import at
      // runtime — see client/index.ts.
      "meteor/10thfloor:agent": ["./packages/agent/client/index.ts"],
      "meteor/10thfloor:agent-channel-slack": ["./packages/agent-channel-slack/server/index.ts"]
    }
  },
  "include": [
    "packages/agent/**/*.ts",
    "packages/agent-channel-slack/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".meteor"
  ]
}
